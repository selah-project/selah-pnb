    {
      "kind": "crux",
      "subject": "מלכם",
      "rationale": "ملکام (عمونی معبود دا ناں) بمقابلہ اوہناں دا بادشاہ — جے ایہہ بادشاہ ہووے تاں ریتاں پڑھدیاں اوہناں دے بادشاہ۔"
    },
    {
      "kind": "addition",
      "subject": "⟨سی⟩",
      "rationale": "عبرانی وِچ کوئی کریالگا نئیں، پنجابی جملہ منگدا اے۔"
    },
    {
      "kind": "measurement",
      "subject": "اِک کِکر سونا",
      "rationale": "تاج دا تول دسیا گیا اے — کِکر سونا۔"
    }
  ],
  "translation": "تے داوِد نے ملکام ⟨دی⟩ تاج ⟨את⟩ اوہدے سر توں لئی، تے اوہدیاں تول اِک کِکر سونا نِکلی، تے اوہدے وِچ اِک قیمتی پتھر ⟨سی⟩، تے اوہ داوِد دے سر اُتے رہی، تے شہر دا مال اوہ بہت زیادہ کڈھیا۔",
