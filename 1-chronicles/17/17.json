    {
      "kind": "crux",
      "subject": "כתור האדם המעלה",
      "rationale": "'اُچے درجے دے بندے وانگ' — مترجماں دی مشہور نفلی: 'چنگے بندے دی شکلاں' (ایلٹی) توں لے کے 'اُچے درجے دا بندہ' (کے جے وی) تک۔"
    },
    {
      "kind": "hapax",
      "subject": "תור",
      "rationale": "ایہہ صورت وِچ תּוֹر (کم از کم ایسے معنےآں وِچ) تنخ وِچ اِکو واری آیا اے۔"
    },
    {
      "kind": "you",
      "subject": "داوِد ولوں یاہوہ نوں",
      "rationale": "داوِد سدھیاں یاہوہ ایلوہیم نوں مخاطب اے۔"
    }
  ],
  "translation": "تے اَے گل تیرے اکھیاں وِچ نِکی رہی، اے ایلوہیم، کیوں جے تُوں اپنے بندے دے گھر بارے دور تک دی گل کیتی اے، تے مینوں اُچے درجے ⟨دے⟩ بندے وانگ ویکھیا اے، اے یاہوہ ایلوہیم۔",
