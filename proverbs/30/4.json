      "subject": "کِسے … کیوں جو تُوں جاندا ایں؟",
      "rationale": "ست سوالاں سُن کے پھیردے نیں — پاٹھ نوں سوال دا نشان اے"
    },
    {
      "kind": "mystery",
      "subject": "اوہدا ناں کی اے، تے اوہدے پُتر دا ناں کی اے",
      "rationale": "جاݨ دا دعوا پچھیا جاندا اے — ناں دسیا نئیں جاندا"
    },
    {
      "kind": "crux",
      "subject": "כי תדע",
      "rationale": "'کیوں جو تُوں جاندا ایں' (طعنہ) جاں 'جے تُوں جاندا ایں' (شرط) — دونویں پڑھائیاں پرچیاں نیں"
    },
    {
      "kind": "measurement",
      "subject": "اسماناں، ہوا، پانی، دھرتی دے کنڈے",
      "rationale": "سمں دے زریعے نال جگ دے انت دے مِتن — پورا کون کَنٹدا اے"
    }
  ],
  "translation": "کِسے اسماناں ਤے چڑھیا تے اُتریا؟ کِسے ہوا نوں اپنیاں مُٹھاں وِچ کٹھا کیتا؟ کِسے پانیاں نوں کپڑے وِچ بنھیا؟ کِسے دھرتی دے سارے کنڈیاں نوں کھلوایا؟ اوہدا ناں کی اے، تے اوہدے پُتر دا ناں کی اے — کیوں جو تُوں جاندا ایں؟",
