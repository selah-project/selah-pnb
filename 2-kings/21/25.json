      "kind": "idiom",
      "subject": "הלא",
      "rationale": "על ספר דברי הימים نوں 'کتابِ واقعات' آکھنا ریت اے پر مطلب اِکو اے — دناں دیاں گلاں دی کتاب"
    },
    {
      "kind": "addition",
      "subject": "ہوئیاں نیں",
      "rationale": "پنجابی فعل مکمل منگدا اے، عبرانی وِچ صرف فعل دا حال اے"
    },
    {
      "kind": "measurement",
      "subject": "دناں دِی کتاب",
      "rationale": "بادشاہاں دے کارنامےآں دی لکھی ہوئی گنتی — عدالتی ریکارڈ"
    }
  ],
  "translation": "تے باقی گلاں اومون دِیاں، جیہڑیاں اوہنے کیتیاں، کی اوہ لکھیاں ہوئیاں نئیں نیں دناں دِی کتاب وِچ، یہوداہ دے بادشاہاں دِیاں؟",
