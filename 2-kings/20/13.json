      "subject": "נכתה",
      "rationale": "ایہہ لفظ تنخ وِچ صرف ایتھے آیا اے — قیمتی مال، مصالے"
    },
    {
      "kind": "crux",
      "subject": "בית כליו",
      "rationale": "برتناں دا گھر بناں ہتھیاراں دا گھر — پراݨے ترجمے ہتھیار منگدے نیں، عبرانی 'کلیم' دوویں دسدا اے"
    },
    {
      "kind": "idiom",
      "subject": "دوہرا منفی",
      "rationale": "'کوئی شے نئیں … جیہڑی نہ وکھایا' — عبرانی دا دوہرا منفی سارے دا سارا دسدا اے"
    },
    {
      "kind": "measurement",
      "subject": "خزانےآں دی لسٹ",
      "rationale": "چاندی، سونا، خوشبو، تیل، برتن، خزانے — گنتی دی طرز تے لسٹ"
    }
  ],
  "translation": "تے حِزقیاہو نے اوہناں دی گل سُنی، تے اوہناں نوں وکھایا ⟨את⟩ سارا گھر اپنے قیمتی مال دا — ⟨את⟩ چاندی تے ⟨את⟩ سونا تے ⟨את⟩ خوشبودار شیواں تے ⟨את⟩ چنگا تیل، تے ⟨את⟩ اپنے برتناں دا گھر، تے ⟨את⟩ سارا جو اوہدے خزانےآں وِچ لبھیا — کوئی شے نئیں سی جیہڑی حِزقیاہو نے اوہناں نوں اپنے گھر وِچ تے اپنی ساری حکومت وِچ نہ وکھایا ہووے۔",
