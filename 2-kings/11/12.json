    {
      "kind": "idiom",
      "subject": "ויכו כף",
      "rationale": "מُڈھ ”ہتھ ماریا” — پنجابی رواج ”تالی ونجھی” اے، دونویں خوشی دا اشارہ۔"
    },
    {
      "kind": "crux",
      "subject": "העדות",
      "rationale": "”گواہی” — گواہی پتر (تورات دا نقل، م eBooksں 17:18–19) یا شاہی نشان؛ جے؎ پاشا ”عہد دا صندوق” وی سمجھیا۔"
    },
    {
      "kind": "addition",
      "subject": "بنایا",
      "rationale": "עם וימלכו اوہنوں — ”بادشاہ بنایا” ای رکھیا، پنجabi فعل پورا کرن لئی۔"
    },
    {
      "kind": "measurement",
      "subject": "تاج تے گواہی",
      "rationale": "تاج لاؤݨ تے گواہی دینا — بادشاہت دے قائم کرن دی رسم دا انگ۔"
    }
  ],
  "translation": "تے اوہنے ⟨את⟩ بادشاہ دے پتر نوں باہر کڈھیا، تے اوہدے اُتے ⟨את⟩ تاج تے ⟨את⟩ گواہی رکھی، تے اوہناں اوہنوں بادشاہ بنایا تے اوہنوں مسح کیتا، تے اوہناں تالی ونجھی تے آکھیا: بادشاہ جیوے!",
