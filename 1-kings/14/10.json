    {
      "kind": "idiom",
      "subject": "משתין בקיר",
      "rationale": "دیوار اُتے پیشاب کرن والا — عبرانی وِچ نَر ہونا دسیا جاندا اے، مترجم اکثر 'ہر نَر' کر دیندے نیں"
    },
    {
      "kind": "crux",
      "subject": "עצור ועזוב",
      "rationale": "بَند ہویا تے چھُڈّیا ہویا — قید کیتا ہویا تے آزاد چھُڈّیا (یا: رہندا تے باقی)، مترجم متفق نئیں"
    },
    {
      "kind": "you",
      "subject": "یَروُوام دے گھر",
      "rationale": "ایہہ اِلہام یاہوہ ولّوں یَروُوام دے ٹبر اُتے فیصلہ اے"
    }
  ],
  "translation": "ایس لئی ویکھو، میں یَروُوام دے گھر اُتے بُرائی لیاؤنا واں، تے یَروُوام توں دیوار اُتے پیشاب کرن والے نوں کٹّ دیناں — بَند ہویا تے چھُڈّیا ہویا، یِسرائیل وِچ — تے یَروُوام دے گھر توں بعد اِنج مِٹاؤناں جیویں گوبر مِٹایا جاندا اے، مُکّن تک۔",
