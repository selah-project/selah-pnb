    {
      "kind": "idiom",
      "subject": "חי יהוה",
      "rationale": "قسم دا عبرانی ڈھنگ — 'جیویں یاہوہ جیوندا اے' — پنجابی وِچ اوویں رکھیا، قسم دا فرمولا اے۔"
    },
    {
      "kind": "addition",
      "subject": "ہے\/نئیں",
      "rationale": "عبرانی وِچ 'میرے کول مَعوگ اے، سگوں اِک مُٹھ…' — پنجابی نفی 'کوئی مَعوگ نئیں' جوڑی تاں جوہر واضح ہووے۔"
    },
    {
      "kind": "you",
      "subject": "ایلیاہ نوں",
      "rationale": "زنانی ایلیاہ نوں جواب دیندی اے — سدھی گل، 'تیرا خدا یاہوہ'۔"
    }
  ],
  "translation": "تے اوہنے آکھیا: جیویں تیرا خدا یاہوہ جیوندا اے، میرے کول کوئی مَعوگ نئیں، سگوں اِک مُٹھ آٹا بھانڈے وِچ تے تھوڑا جیہا تیل پیالے وِچ؛ تے ویکھ، میں دو سونڈیاں کٹھیاں کردی آں، کہ میں آواں تے اوہنوں اپنے لئی تے اپنے پتر لئی پکاواں، تے اسیں اوہنوں کھا کے مر جاہیے۔",
