      "subject": "ויחר אף",
      "rationale": "'ناس بھڑکیا' عبرانی غصے دی رِیت اے — 'אף' ناس\/نکّ اے، 'غصہ' بن کے آیا۔"
    },
    {
      "kind": "substitution",
      "subject": "ویچ دتا",
      "rationale": "וימכרטکھیویں 'بیچ دتا' — غلامی نوں ویچن دی ہوند تصویر، جےپیئیس دی 'دے ہتھ سُپرد کیتا' نرم پیندی اے۔"
    },
    {
      "kind": "measurement",
      "subject": "اَٹھ ورھے",
      "rationale": "غلامی دی مدت دی گنتی — کتاب قضاۃ دا پیندا نقشہ اِیہو نمبر اے۔"
    },
    {
      "kind": "alternative",
      "subject": "اَرام نہرایم",
      "rationale": "ریتی 'میسوپوٹامیا' دی تھاں حرف-نقل 'اَرام نہرایم' ⟨دو دریاواں دا اَرام⟩ رکھیا۔"
    }
  ],
  "translation": "تے یاہوہ دا غصہ یِسرائیل اُتے بھڑکیا، تے ⟨اوہنے⟩ اوہناں نوں کوشن-رشعتایم، اَرام نہرایم دے بادشاہ، دے ہتھ ویچ دتا، تے یِسرائیل دے پُتراں نے ⟨את⟩ کوشن-رشعتایم دی سیوا اَٹھ ورھے کیتی۔",
