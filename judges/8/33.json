      "subject": "ויזנו",
      "rationale": "زنا دی اِدومے عبرانی وِچ بتّاں دی پوجا لئی اے — ترجمے وِچ پکی مورت رکھی گئی اے"
    },
    {
      "kind": "addition",
      "subject": "⟨دی تھاں⟩",
      "rationale": "לאלהים دی مطلب 'ایلوہیم دے طور تے' — پنجابی جملے لئی 'دی تھاں' پایا گیا"
    },
    {
      "kind": "substitution",
      "subject": "بعل بِریت",
      "rationale": "ناں اے 'عہد دا بعل' — اِکو حرف-نقل رکھیا گیا"
    }
  ],
  "translation": "تے ہویا ⟨ایوں⟩ جدوں گِدعون مریا، تے یِسرائیل دے پُتر مُڑ آئے تے بعل اِم دے پِچھے زِنا کیتا، تے اوہناں نے اپنے لئی بعل بِریت نوں ایلوہیم ⟨دی تھاں⟩ بݨایا۔",
