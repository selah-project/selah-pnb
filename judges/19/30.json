    {
      "kind": "invitation",
      "subject": "صلاح کرو تے بولو",
      "rationale": "حکری صورتاں قبیلیاں نوں اِکٹھے ہو کے فیصلہ کرن دا سدا دیندیاں نیں۔"
    },
    {
      "kind": "you",
      "subject": "یِسرائیل دے قبیلیاں نوں",
      "rationale": "آیت دا آخر سدھا سنن والیاں نوں مخاطب اے۔"
    },
    {
      "kind": "measurement",
      "subject": "اُس دن توں … اَج دے دن تک",
      "rationale": "وقت دا حساب — مِتصرایم توں نِکلن توں ہن تک کوئی ایہو جیہا نئیں ہویا۔"
    }
  ],
  "translation": "تے ایہہ ہویا کہ ہر اوہ جیہڑا ویکھدا سی، اوہ آکھدا سی: “نئیں ہویا تے نئیں ویکھیا گیا ایہو جیہا، اُس دن توں جِدھن یِسرائیل دے پُتر مِتصرایم دے دیس توں چڑھے، اَج دے دن تک۔ اپنے دل نوں ایہدے اُتے لاوو، صلاح کرو تے بولو۔”",
