  "notes": [
    {
      "kind": "idiom",
      "subject": "על יד היאר",
      "rationale": "عبرانی ’دریاے دے ہتھ تے‘ ریت دا محاورہ اے — کنارا، پنجابی وِچ ’کنارے‘ آکھیا اے۔"
    },
    {
      "kind": "addition",
      "subject": "لئی",
      "rationale": "عبرانی ותקחה توں پہلاں اِک مفعول دا نشان مگر مفہوم دے رستے وِچ ’اوہنوں‘ — عبرانی صرف فعل لیندی اے؛ آخری ⟨את⟩ گلاس دا نشان اے۔"
    },
    {
      "kind": "crux",
      "subject": "ותקחה",
      "rationale": "کجھ مفسر אמתה نوں ’اوہدا ہتھ‘ پڑھدے نیں (موسے نوں پھڑیا)، پر ڈھکویں معنی ’داسی‘ اے جیہڑی ڈبّا لے آئی۔"
    }
  ],
  "translation": "تے پِعرعوہ دی دھی دریاے تے نہاؤن ⟨لئی⟩ اتری، تے اوہدیاں نوجوان داسیاں دریاے دے کنارے تُریاں، تے اوہنے ⟨את⟩ ڈبّے نوں کَنّیاں وِچ ویکھیا، تے اوہنے ⟨את⟩ اوہدی داسی نوں گھلیا، تے اوہنے ⟨את⟩ اوہنوں لیا۔",
