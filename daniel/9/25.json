      "subject": "ویلےآں دا حساب",
      "rationale": "ست ہفتے تے سَٹھ تے دو ہفتے — پروفیت گیبریل دا نمبراں نال قریبی زمانہ ناپنا"
    },
    {
      "kind": "invitation",
      "subject": "تُوں جان لے تے سمجھ",
      "rationale": "آیت دانی ایل نوں سدھی سنیعھ دیندی اے — سنن والے نوں سمجھن دا حکم"
    },
    {
      "kind": "crux",
      "subject": "ماشیاخ سردار",
      "rationale": "کون Mashíaj nágid اے — کیرو، زربابل، انتیوکس ورگے مطلب، زمانے دا حساب وکھرا کر دیندا اے"
    },
    {
      "kind": "hapax",
      "subject": "وَڳ (חרוץ)",
      "rationale": "ایہہ لفظ تنخ وِچ صرف ایتھے آیا اے — نہری وَڳ جاں کھائی، مطلب نسچت نئیں"
    }
  ],
  "translation": "تے تُوں جان لے تے سمجھ، کہ بول دے نکلن توں — یروشلایم نوں واپس لیان تے بنان لئی — ماشیاخ سردار تک ست ہفتے نیں، تے سَٹھ تے دو ہفتے؛ تے سڑک واپس آؤندی ہووے تے بنی ہووے، وَڳ وی، تنگی وِچ ویلےآں دے۔",
