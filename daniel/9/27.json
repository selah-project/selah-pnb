      "rationale": "اِک ہفتہ تے اوہدا ادھ — گݨتی دا انگ، ہفتہ گݨتی دا آخری پڑاء۔"
    },
    {
      "kind": "crux",
      "subject": "گھناؤنیاں شیواں دے پر اُتے",
      "rationale": "כנף שקוצים: 'پر' پکھی دا، فوج دے کنارے دا، یا مکعب اُتے اُترے ہوئے بت دے — مترجم ونڈے ہوئے نیں۔"
    },
    {
      "kind": "wordplay",
      "subject": "משמם \/ שמם",
      "rationale": "'اُجڑان والا' تے 'اُجڑن والا' — اوہو جڑ ש-מ-م، پنجابی وِچ وہمی آواز رکھی گئی اے پر عبرانی دی ادھوری چمار۔"
    },
    {
      "kind": "mystery",
      "subject": "طے کیتا ہویا ڈھالیا جائے گا",
      "rationale": "گل مُہریاں طے شدہ انت ول ٹُردی اے — پر درواذہ بند، دانی ایل 12:4 تک مُہر کھُلدی اے۔"
    }
  ],
  "translation": "تے اوہ بہت ساریاں نال اِک ہفتے لئی عہد تکڑا کریگا، تے ہفتے دے ادھ وِچ قربانی تے نذر بند کر دیوے گا، تے گھناؤنیاں شیواں دے پر اُتے اُجڑان والا ہووےگا، تے انت تک — تے جو طے کیتا گیا اے اوہ اُجڑن والے اُتے ڈھالیا جائے گا۔",
