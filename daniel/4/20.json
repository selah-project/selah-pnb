      "kind": "hapax",
      "subject": "עיר",
      "rationale": "نگہبان — تنخ وچ صرف دانی ایل دی ارومی آیتاں وچ ملدا اے، فرشتے دا اے خاص ناں"
    },
    {
      "kind": "measurement",
      "subject": "ست ویلے",
      "rationale": "עדנין مقرر ویلے نیں — ست ویلے گنے جاندے نیں"
    },
    {
      "kind": "crux",
      "subject": "עדנין",
      "rationale": "مقرر ویلے دا مطلب سال لئی لیا جاندا اے، کجھ ست سال، کجھ ہور مدتاں منگدیاں نیں"
    },
    {
      "kind": "alternative",
      "subject": "חלקה",
      "rationale": "اوہدا حصہ — مول وچ بادشاہ دے بارے وچ پڑھیا جاندا اے، رُکھ توں بندے ول پھیر صرف سیاق توں آندا اے"
    }
  ],
  "translation": "تے جو بادشاہ نے ویکھیا کہ اِک نگہبان تے مقدس اسمان توں اُتریا تے آکھیا: رُکھ نوں کَٹو تے اوہنوں برباد کرو، پر اوہدیاں جڑاں دا تنا دھرتی وِچ رہن دیو، لوہے تے پیتل دی زنجیر وِچ، بَر دے گھاہ وِچ، تے اسمان دی اوس نال اوہنوں بھیگنا ہووے تے بَر دے جانوراں نال اوہدا حصہ ہووے، ادوں تک جدوں تک ست ویلے اوہدے اُتے لنگھن۔",
