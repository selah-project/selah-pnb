      "kind": "idiom",
      "subject": "בנות פלשתים \/ בנות הערלים",
      "rationale": "“دھیاں” (بنوت) عبرانی وِچ شہر دے وسنیکاں لئی وی اے — ایتھے پلتستی لوکاں دے سہیل پکھ لئی اے"
    },
    {
      "kind": "substitution",
      "subject": "בחוצת",
      "rationale": "لفظی “باہرلیاں تھاواں\/چوکاں” — “گلیاں” ریت دا سہج ترجمہ اے"
    },
    {
      "kind": "crux",
      "subject": "הערלים",
      "rationale": "“بےختنے” — بعض مترجم “اَغلف” یعنی نا-ختنے لکھدے نیں؛ عبرانی “عُرلات والے” اے"
    },
    {
      "kind": "wordplay",
      "subject": "תשמחנה \/ תעלזנہ",
      "rationale": "دوویں خوشی دے کریاواں دی جوڑی — پہلی سادہ خوشی، دوجی اچھلی خوشی — پنجابی وِچ پدھر رکھی گئی"
    },
    {
      "kind": "invitation",
      "subject": "to Israel",
      "rationale": "آیت حکم نال مخاطب اے — خبر چُپائے دی اپیل"
    }
  ],
  "translation": "گتھ وِچ نہ دسیا کرو، اَشقیلون دیاں گلیاں وِچ خوشخبری نہ پھیلائے کرو، کہ کتے نہ بندے پلتستیاں دیاں دھیاں خوش ہوݨ، کہ کتے نہ بےختنےآں دیاں دھیاں اچھل کے خوشی مناؤن۔",
