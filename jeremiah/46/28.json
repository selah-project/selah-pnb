    {
      "kind": "crux",
      "subject": "כי אעשה כלה",
      "rationale": "”کیونکہ“ یا ”بھاویں“ — یاہوہ دے نال ہوون تے قوماں دا مُکاونا اِکو وعدہ اے یا الٹ؟ مترجم ونڈے ہوئے نیں؛ حرف כי نوں اویں رکھیا گیا۔"
    },
    {
      "kind": "you",
      "subject": "یعقوو",
      "rationale": "سدیاں مخاطب — یاہوہ دا اعلان غلام یعقوو لئی۔"
    },
    {
      "kind": "elision",
      "subject": "ונקה לא אנקך",
      "rationale": "دوہری نفی — ”خالی نئیں چھڑاواں گا“ — عبرانی فعل تے نفی دو واری آئے؛ پنجابی وچ فعل اِک واری، نفی دی جوڑ ساں رکھی۔"
    }
  ],
  "translation": "توں ناں ڈر، میرے غلام یعقوو، یاہوہ آکھدا اے، کیونکہ میں تیرے ⟨את⟩ نال آں؛ کیونکہ میں ساریاں اوہناں قوماں دا مُکا کراں گا جِتھے میں تینوں دھکّیا اے، پر ⟨את⟩ تینوں میں مُکا نئیں کراں گا، پر میں تینوں عدالت نال تلیم دوواں گا، تے تینوں سزا توں خالی نئیں چھڈاں گا۔",
