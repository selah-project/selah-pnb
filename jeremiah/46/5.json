    {
      "kind": "idiom",
      "subject": "מגור מסביב",
      "rationale": "'وَس ہر پاسے' — یرمیاہو دی مُکھ منتر واکی، اِکو عبرانی جوڑ اکٹھا رکھیا اے۔"
    },
    {
      "kind": "invitation",
      "subject": "מדוע ראיתי",
      "rationale": "سوال نال وِچار نوں سدیا گیا اے — پرچیا ہویا سوال اے۔"
    }
  ],
  "translation": "میں نے کیوں ویکھیا کہ اوہ دب گئے، پچھے نوں مُڑ کے پچھانہے ٹُر گئے، تے اوہناں دے سورمے کُٹے گئے، تے بھجّ نِکل گئے تے مُڑ کے نئیں ویکھیا؟ ہر پاسے وَس اے — یاہوہ آکھدا اے۔",
