      "subject": "ריח הניחח",
      "rationale": "ریَاخ هَنِّیّواخ — خوشبو تے 'آرام' اکو جڑ (נוח) توں؛ 'آرام دین والی خوشبو' اوہدیاں جھلک رکھدا اے"
    },
    {
      "kind": "idiom",
      "subject": "לא אסף",
      "rationale": "'ناں وادھا کراں' = 'ہور نئیں'؛ לفظی 'وادھا' پنجابی وِچ بھاری پیندا"
    },
    {
      "kind": "substitution",
      "subject": "יצר",
      "rationale": "יצר کسے دا گھڑیا ہویا سانچہ اے؛ 'قصہ' (ماڑا جھکاؤ) نیڑےویں اے پر سانچے دی تصویر ہل جاندی اے"
    },
    {
      "kind": "addition",
      "subject": "اپنے",
      "rationale": "לבו وِچ سرخیئوی ضمیر اے پر پنجابی 'اپنے' وکھرا لفظ منگدا اے"
    }
  ],
  "translation": "تے یاہوہ نے آرام دین والی خوشبو نوں ⟨את⟩ سونگیا، تے یاہوہ نے اپنے دل وِچ آکھیا: میں ہور انسان دے کارن ⟨את⟩ زمین نوں لعنت نئیں کراںگا، کیونکہ انسان دے دل دا قصہ اوہدیاں نکیاں عمراں توں ماڑا اے؛ تے میں ہور سارے جیوندیاں نوں ⟨את⟩ نئیں ماراںگا، جیویں میں کیتا اے۔",
