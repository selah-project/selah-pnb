    {
      "kind": "substitution",
      "subject": "جھاگ",
      "rationale": "פחז مُکھ روپ 'ابالدا ہویا جھاگ' اے — کجھ ترجمے 'اِستھیر نئیں' دا مطلب دے دیندے نیں"
    },
    {
      "kind": "crux",
      "subject": "תותר",
      "rationale": "'ودھیں گا' جاں 'رہ جاوِن گا' — ترجمے ونڈے ہوئے نیں"
    },
    {
      "kind": "addition",
      "subject": "⟨اوہنوں⟩ ⟨اوہ⟩",
      "rationale": "عبرانی مفعول تے فاعل صیغہ صاف نئیں کردا، پنجابی واضح کردا اے"
    },
    {
      "kind": "crux",
      "subject": "עלה",
      "rationale": "آخری لفظ تنّیں صورت وِچ اے — 'اوہ چڑھ گیا' — بولن والا بدلدا اے (یعقوو پُتر دے بچن پچھے آپݨے آپ نوں دہروندا اے)"
    }
  ],
  "translation": "جھاگ جِویں پانی — تُوں فروال نئیں پاویں گا، کیونکہ تُوں آپݨے پیو دِیاں بستریاں اُتے چڑھیا؛ اُدوں تُوں ⟨اوہنوں⟩ پلیت کیتا — ⟨اوہ⟩ میڈی بستر اُتے چڑھ گیا۔",
