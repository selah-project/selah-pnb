      "kind": "crux",
      "subject": "ہتھ ران ہیٹھ",
      "rational": "قسم دا قدیم سامی رسم اے — 24:2 وِچ وی؛ کجھ مترجم اوہنوں نرم کر کے 'وعدہ کر' آکھدے نیں، صورت مٹ جاندی اے"
    },
    {
      "kind": "substitution",
      "subject": "خیسِد",
      "rational": "חסד عبرانی لفظ نشان لگا کے رکھیا — رحم، وفاداری تے چنڳیائی سار کجھ اے، اِک پنجابی لفظ اوہدیاں ساریاں ودھاناں نئیں پال سکدا"
    },
    {
      "kind": "idiom",
      "subject": "مرن دے دن نیڑے ہوئے",
      "rational": "עברית 'دن نیڑے آؤن' — مرن دا ویلا چڑھیا، سوکھا پنجابی 'ویلا نیڑے اے'"
    },
    {
      "kind": "you",
      "subject": "یعقوو توں یوسف نوں",
      "rational": "پیو دا پُتر نوں سدہا خطاب — 'جے میں تیریاں اکھیاں وِچ چاہ لبھیا'"
    }
  ],
  "translation": "تے یِسرائیل دے مرن دے دن نیڑے ہوئے، تے اوہنے اپنے پُتر یوسف نوں بلایا تے اوہنوں آکھیا: جے میں تیریاں اکھیاں وِچ چاہ لبھیا ہاں، تاں اپنا ہتھ میری ران ہیٹھ رکھ، تے میرے نال خیسِد تے سچائی کریں؛ مینوں مِتصرایم وِچ نہ دفناویں۔",
