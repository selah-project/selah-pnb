    {
      "kind": "crux",
      "subject": "לֹא יָדְעוּ אִישׁ",
      "rationale": "'کسے بندے نوں نہیں جاݨدیاں' — جاننا دا ایہو یُوپھمزم اے؛ لفظی 'جاݨیاں' رکھیا اے"
    },
    {
      "kind": "idiom",
      "subject": "בְּצֵל קֹרָתִי",
      "rationale": "'میری چھت دے چھاں ہیٹھ' — مہمان نوں سرپناست دا سامی محاورہ؛ صرف چھاں نہیں، پناہ"
    },
    {
      "kind": "you",
      "subject": "سدوم دے بندے",
      "rationale": "لُوط دا سدوم دے بندیاں نوں سدّیا ہویا خطاب، دھیاں دی پیشکش نال"
    }
  ],
  "translation": "ویکھو، منگدا آں، مینوں دو دھیاں نیں جیہڑیاں کسے بندے نوں نہیں جاݨیاں؛ مینوں منگدا آں اوہناں نوں تہاڈے کول کڈھاں، تے اوہناں نال اوہ کرو جیہڑا تہاڈیاں اکھیاں وِچ چنگا لگے؛ صرف ایہناں بندیاں نال کوئی گل نہ کرو، کیوں جو ایسے لئی اوہ میری چھت دے چھاں ہیٹھ آئے نیں۔",
