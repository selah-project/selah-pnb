      "kind": "crux",
      "subject": "ומיציאו מעיו",
      "rationale": "پیٹ توں نِکلن والے — یعنی اوہدے اپنے پُتر؛ کئی مترجم 'پُتر' لکھدے نیں، صورت دا لفظ 'پیٹ توں نِکلن والے' اے۔"
    },
    {
      "kind": "idiom",
      "subject": "בבשת פנים",
      "rationale": "شرم دے مونہہ نال — عبرانی دی مورت اِی رکھی اے۔"
    }
  ],
  "translation": "تے یاہوہ نے اِک فرشتہ گھلیا، تے اوہنے آشُّور دے بادشاہ دے پڑاؤ وِچ ہر بہادر جنگجو تے ہر سردار تے امیر نوں مِٹا دتا؛ تے اوہ شرم دے مونہہ نال اپنی زمین نوں مُڑیا، تے اپنے دیوتے دے گھر وِچ آیا، تے جیہڑے اوہدے پیٹ توں نِکلے، اوہناں اوہنوں اوتھے تلوار نال ڈِگھا دتا۔",
