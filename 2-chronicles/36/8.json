    {
      "kind": "idiom",
      "subject": "הנם",
      "rationale": "'دیاں لکھتاں وِچ نیں' — ہبرو 'ہن، دیکھو' دی شکل، پنجابی وِچ فعل لڑی نال رلایا"
    },
    {
      "kind": "crux",
      "subject": "והנמצא עליו",
      "rationale": "'جو اوہدے اُتے لبھیا' — دھرمی توہین دا مطلب لبھیا یا اوہدے خلاف گواہی"
    },
    {
      "kind": "measurement",
      "subject": "بادشاہاں دی کتاب",
      "rationale": "لکھتی ریکارڈ دا حوالہ — لکھتاں دی گنتی آیت"
    }
  ],
  "translation": "تے یہویاقیم دے باقی کماں تے اوہدیاں گھناؤنیاں گلاں دا، جیہڑیاں اوہنے کیتیاں تے جو اوہدے اُتے لبھیا، دیاں لکھتاں وِچ نیں — بادشاہاں دی کتاب وِچ، یِسرائیل تے یہوداہ دی — تے اوہدے پتر یہویاکین نے اوہدی تھاں راج کیتا۔",
