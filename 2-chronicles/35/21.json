    {
      "kind": "idiom",
      "subject": "מה לי ולך",
      "rationale": "عبرانی دا محاورہ 'مینوں تے تینوں کی' — مطلب میرا تیرے نال کی وستھ اے"
    },
    {
      "kind": "crux",
      "subject": "בית מלחמתי",
      "rationale": "'میری جنگ دا گھر' — ترجمے اس نوں 'میرا جنگی مخالف' یا 'دوجا راج' بنا دیندے نیں؛ شکل گھر ای رکھی"
    },
    {
      "kind": "crux",
      "subject": "מאלהים",
      "rationale": "نِکو آکھدا اے 'ایلوہیم نے مینوں دوڑایا' — متن ایلوہیم دا ناں اِکو رکھدا اے، کوئی وضاحت نئیں"
    },
    {
      "kind": "you",
      "subject": "یوشییاهو ول",
      "rationale": "نِکو دا پیغام بادشاہ یوشییاهو نوں سدھا مخاطب اے"
    }
  ],
  "translation": "تے اُس نے اوہدے کول پیغام بھیجے کہ آکھے: مینوں تے تینوں کی، اے یہوداہ دے بادشاہ؟ اِج اَنا تیرے خلاف نئیں آیا، سگوں میری جنگ دے گھر ⟨ول⟩ آیا واں، تے ایلوہیم نے آکھیا اے جو مینوں دوڑاوے؛ توں اوہ ایلوہیم توں رُک جا جیہڑا میرے نال اے، تے اوہ تینوں نہ برباد کرے۔",
