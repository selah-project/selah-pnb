      "subject": "تُسیں",
      "rationale": "چِٹھی دا سبھ توں سِدھا حُکم — مخاطب یِسرائیل تے یہوداہ دے لوک۔"
    },
    {
      "kind": "invitation",
      "subject": "ہتھ دو … آؤ … خدمت کرو",
      "rationale": "تِن حکم پے در پے، سدے دی لہر۔"
    },
    {
      "kind": "idiom",
      "subject": "تَنُو یاد",
      "rationale": "'ہتھ دینا' عبرانی محاورہ اے — سپردگی\/سامبھن دا اشارہ؛ لفظی 'ہتھ دو' رکھیا گیا اے۔"
    },
    {
      "kind": "idiom",
      "subject": "חרון אף",
      "rationale": "لفظی 'نَکّ دی بھڑک' — غصے دا عبرانی تصویر، 'غصے دی تپش' رکھیا۔"
    }
  ],
  "translation": "ہن اپنی گردن سخت نہ کرو جداں تہاڈے پیؤ کردے سن؛ یاہوہ نوں ہتھ دو تے اوہدے مقدس مقام وِچ آؤ، جیہڑا اوہنے ہمیشاہ لئی مقدس کیتا اے، تے یاہوہ، اپنے ایلوہیم دی خدمت کرو، تاں جو اوہدے غصے دی تپش تہاڈے توں مُڑ جاوے۔",
